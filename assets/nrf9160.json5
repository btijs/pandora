{
    "regions": [
        // Flash: 32 regions of 32KB each, starting at 0x0
        // RAM: 32 regions of 8KB each, starting at 0x20000000
        // NS Peripherals: 0x40000000 - 0x4FFFFFFF

        // For riot-tee:
            // first 4 flash regions are S, rest is NS
            // first 8 RAM regions are S, rest is NS

            // 4th flash region last 32B are NSC
        {
            // NS flash
            "number": 1,
            "start_address": 0x00020000,
            "end_address": 0x000FFFFF,
            "security_attribute": "nonsecure",
        },
        {
            // NSC flash
            "number": 2,
            "start_address": 0x0001FFE0,
            "end_address": 0x0001FFFF,
            "security_attribute": "nonsecure_callable",
        },
        {
            // NS RAM
            "number": 3,
            "start_address": 0x20000000,
            "end_address": 0x2003FFFF,
            "security_attribute": "nonsecure",
        },
        {
            // NS peripherals
            "number": 4,
            "start_address": 0x40000000,
            "end_address": 0x4FFFFFF,
            "security_attribute": "nonsecure",
        }
    ]
}