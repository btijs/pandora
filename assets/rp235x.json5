{
    // Source table:
    //   0x00000000-0x000042ff  Arm boot          Exempt
    //   0x00004300-0x00007dff  USB/RISC-V boot   Non-secure (instruction fetch), Exempt (load/store)
    //   0x00007e00-0x00007fff  Bootrom SGs       Secure and Non-secure-Callable
    //   0x10000000-0x1fffffff  XIP               Non-secure
    //   0x20000000-0x20081fff  SRAM              Non-secure
    //   0x40000000-0x4fffffff  APB               Exempt
    //   0x50000000-0x5fffffff  AHB               Exempt
    //   0xd0000000-0xdfffffff  SIO               Exempt
    "regions": [
        {
            // Arm boot
            "number": 0,
            "start_address": 0x00000000,
            "end_address": 0x000042FF,
            "security_attribute": "secure",
            "exempted": true,
        },
        {
            // USB / RISC-V boot: the IDAU reports different attributes for instruction
            // fetch vs. load/store in this window (a documented fetch-vs-data quirk).
            "number": 0,
            "start_address": 0x00004300,
            "end_address": 0x00007DFF,
            "security_attribute": "nonsecure",
            "exempted": true,
        },
        {
            // Bootrom Secure Gateways (this NSC window is fixed in IDAU hardware)
            "number": 0,
            "start_address": 0x00007E00,
            "end_address": 0x00007FFF,
            "security_attribute": "nonsecure_callable",
        },
        {
            // XIP: external flash / PSRAM
            "number": 1,
            "start_address": 0x10000000,
            "end_address": 0x1FFFFFFF,
            "security_attribute": "nonsecure",
        },
        {
            // SRAM (520 KB)
            "number": 2,
            "start_address": 0x20000000,
            "end_address": 0x20081FFF,
            "security_attribute": "nonsecure",
        },
        {
            // APB peripherals (effective S/NS decided by ACCESSCTRL)
            "number": 4,
            "start_address": 0x40000000,
            "end_address": 0x4FFFFFFF,
            "security_attribute": "secure",
            "exempted" : true,
        },
        {
            // AHB peripherals (effective S/NS decided by ACCESSCTRL)
            "number": 5,
            "start_address": 0x50000000,
            "end_address": 0x5FFFFFFF,
            "security_attribute": "secure",
            "exempted" : true,
        },
        {
            // SIO: core-local peripherals, accessed via each core's IOPORT.
            "number": 13,
            "start_address": 0xD0000000,
            "end_address": 0xDFFFFFFF,
            "security_attribute": "secure",
            "exempted" : true,
        },
    ]
}
